{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymath.dev/spec/run-result.schema.json",
  "title": "RunResult",
  "type": "object",
  "properties": {
    "session_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "state": {"type": "string", "enum": ["completed", "failed", "canceled"]},
    "stop_reason": {"type": "string", "enum": ["finished", "text_answer", "finished_unverified", "budget_exhausted", "model_error", "no_progress", "canceled", "crash"]},
    "answer": {"type": ["string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "usage": {"type": "object"},
    "turns": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "duration_s": {"type": "number", "minimum": 0},
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passed": {"type": "boolean"},
          "method": {"type": "string", "enum": ["command", "judge", "none"]},
          "detail": {"type": "string"},
          "round": {"type": "integer", "minimum": 0}
        },
        "required": ["passed", "method"]
      }
    },
    "error": {"type": ["string", "null"]},
    "models_used": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["session_id", "agent_id", "state", "stop_reason", "answer", "usage", "turns", "tool_calls"]
}
