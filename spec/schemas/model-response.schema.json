{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymath.dev/spec/model-response.schema.json",
  "title": "ModelResponse",
  "type": "object",
  "properties": {
    "content": {"type": ["string", "null"]},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "required": ["input_tokens", "output_tokens"]
    },
    "model": {"type": "string"},
    "finish_reason": {"type": ["string", "null"]},
    "reasoning": {"type": ["string", "null"], "description": "Provider reasoning_content or inline <think> text, journaled but not re-sent by default."},
    "latency_s": {"type": "number", "minimum": 0},
    "protocol": {"type": "string", "enum": ["native", "text"]},
    "attempts": {"type": "integer", "minimum": 1}
  },
  "required": ["content", "tool_calls", "usage", "model"]
}
